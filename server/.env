NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://chemilinx:chemilinx@localhost:5433/chemilinx
# Public origin(s) of the website, comma separated (used for CORS + Origin checks)
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
SESSION_TTL_HOURS=12
COOKIE_SECURE=false
UPLOAD_DIR=./uploads
# Initial admin created by `npm run db:seed` (change immediately)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
# Email (SMTP). Leave SMTP_HOST empty to skip sending (records are still saved).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Chemilinx Website <no-reply@example.com>"
NOTIFY_EMAIL=
